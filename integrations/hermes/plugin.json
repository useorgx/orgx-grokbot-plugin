{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "orgx-hermes",
  "version": "0.1.0",
  "description": "Use OrgX workspace decisions, artifacts, approvals, and work receipts from Hermes with explicit OAuth authorization.",
  "author": {
    "name": "OrgX",
    "url": "https://useorgx.com"
  },
  "homepage": "https://useorgx.com",
  "repository": "https://github.com/useorgx/orgx-grokbot-plugin",
  "license": "MIT",
  "keywords": [
    "orgx",
    "mcp",
    "work-receipts",
    "decision-history",
    "human-approval"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "orgx": {
          "trust": "untrusted"
        }
      }
    }
  }
}
